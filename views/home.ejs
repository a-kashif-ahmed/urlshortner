<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upins — URL Shortener</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black:    #0B0909;
      --forest:   #2E4540;
      --teal:     #408175;
      --lavender: #B5B9F0;
      --surface:  #131918;
      --card:     #1a2220;
      --border:   #253430;
      --text:     #e8ebe9;
      --muted:    #6b8078;
      --mono:     'JetBrains Mono', monospace;
      --sans:     'Inter', sans-serif;
      --r:        10px;
    }

    html, body { min-height: 100%; background: var(--black); }

    body {
      font-family: var(--sans);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 56px 20px 80px;
    }

    header {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 52px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .logo-mark {
      width: 42px; height: 42px;
      background: var(--teal);
      border-radius: 12px;
      display: grid;
      place-items: center;
    }

    .logo-mark svg { display: block; }

    h1 {
      font-size: 1.85rem;
      font-weight: 600;
      letter-spacing: -0.04em;
      color: var(--text);
    }

    h1 em { font-style: normal; color: var(--lavender); }

    .tagline {
      font-size: 0.8rem;
      color: var(--muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .card {
      width: 100%;
      max-width: 640px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 30px;
      margin-bottom: 16px;
    }

    .field-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .input-row { display: flex; gap: 10px; }

    input[type="text"] {
      flex: 1;
      background: var(--black);
      border: 1px solid var(--border);
      border-radius: var(--r);
      padding: 13px 16px;
      color: var(--text);
      font-family: var(--mono);
      font-size: 0.83rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input[type="text"]::placeholder { color: var(--muted); }

    input[type="text"]:focus {
      border-color: var(--teal);
      box-shadow: 0 0 0 3px rgba(64, 129, 117, 0.18);
    }

    button[type="submit"] {
      background: var(--teal);
      color: #fff;
      border: none;
      border-radius: var(--r);
      padding: 13px 22px;
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s, transform 0.15s;
    }

    button[type="submit"]:hover { background: #4d9787; }
    button[type="submit"]:active { transform: scale(0.97); }

    .result {
      margin-top: 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 16px;
      background: rgba(181, 185, 240, 0.07);
      border: 1px solid rgba(181, 185, 240, 0.22);
      border-radius: var(--r);
    }

    .result-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--lavender);
      flex-shrink: 0;
      animation: glow 2.2s infinite;
    }

    @keyframes glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(181,185,240,0.5); }
      50%       { box-shadow: 0 0 0 6px rgba(181,185,240,0); }
    }

    .result-tag {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--lavender);
      flex-shrink: 0;
    }

    .result-url {
      font-family: var(--mono);
      font-size: 0.825rem;
      color: var(--text);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      flex: 1;
    }

    .copy-btn {
      flex-shrink: 0;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 12px;
      color: var(--muted);
      font-size: 0.72rem;
      font-family: var(--sans);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }

    .copy-btn:hover { border-color: var(--lavender); color: var(--lavender); }

    .error-banner {
      margin-top: 20px;
      padding: 12px 16px;
      background: rgba(220, 80, 80, 0.08);
      border: 1px solid rgba(220, 80, 80, 0.25);
      border-radius: var(--r);
      color: #e89090;
      font-size: 0.85rem;
    }

    .show-btn-wrap {
      display: flex;
      justify-content: center;
    }

    .show-btn {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: var(--r);
      padding: 11px 28px;
      color: var(--muted);
      font-family: var(--sans);
      font-size: 0.85rem;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }

    .show-btn:hover { border-color: var(--teal); color: var(--teal); }

    .section-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    .section-title {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
    }

    .count-pill {
      font-family: var(--mono);
      font-size: 0.7rem;
      background: var(--border);
      color: var(--muted);
      padding: 3px 9px;
      border-radius: 20px;
    }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      text-align: left;
      padding: 0 10px 12px;
      border-bottom: 1px solid var(--border);
    }

    thead th:first-child { padding-left: 0; width: 36px; }
    thead th:last-child  { width: 60px; }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.15s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: rgba(255,255,255,0.02); }

    tbody td {
      padding: 14px 10px;
      font-size: 0.85rem;
      vertical-align: middle;
    }

    tbody td:first-child {
      padding-left: 0;
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--muted);
    }

    .td-actual {
      color: var(--muted);
      font-size: 0.8rem;
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .td-short {
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--lavender);
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .row-copy {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 4px 10px;
      color: var(--muted);
      font-size: 0.7rem;
      font-family: var(--sans);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }

    .row-copy:hover { border-color: var(--lavender); color: var(--lavender); }

    .about {
      width: 100%;
      max-width: 640px;
      padding: 6px 0 0;
    }

    .about h3 {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .about p {
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.6;
    }

    footer {
      margin-top: 52px;
      font-size: 0.75rem;
      color: var(--muted);
      text-align: center;
    }

    footer a { color: var(--teal); text-decoration: none; }
    footer a:hover { color: var(--lavender); }

    @media (max-width: 520px) {
      .input-row { flex-direction: column; }
      .td-actual, .td-short { max-width: 100px; }
    }
  </style>
</head>
<body>

  <header>
    <div class="logo">
      <div class="logo-mark">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
      </div>
      <h1>Up<em>i</em>ns</h1>
    </div>
    <p class="tagline">Paste long. Get short. Share fast.</p>
  </header>

  <div class="card">
    <label class="field-label">Your long URL</label>
    <form method="post" action="/">
      <div class="input-row">
        <input type="text" name="url" placeholder="https://example.com/very/long/url/goes/here">
        <button type="submit">Shorten →</button>
      </div>
    </form>

    <% if (locals.convUrl) { %>
    <div class="result">
      <div class="result-dot"></div>
      <span class="result-tag">Ready</span>
      <span class="result-url"><%= convUrl %></span>
      <button class="copy-btn"
        onclick="navigator.clipboard.writeText('<%= convUrl %>');this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)">
        Copy
      </button>
    </div>
    <% } %>

    <% if (locals.msg) { %>
    <div class="error-banner"><strong>Error:</strong> <%= msg %></div>
    <% } %>
  </div>

  <div class="card" style="padding: 20px 30px;">
    <form method="post" action="/urls">
      <div class="show-btn-wrap">
        <button type="submit" class="show-btn">↓ Show my generated URLs</button>
      </div>
    </form>
  </div>

  <% if (locals.result && result.length > 0) { %>
  <div class="card">
    <div class="section-bar">
      <span class="section-title">Your links</span>
      <span class="count-pill"><%= result.length %></span>
    </div>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Original URL</th>
          <th>Short URL</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% result.forEach((url, i) => { %>
        <tr>
          <td><%= String(i + 1).padStart(2, '0') %></td>
          <td class="td-actual" title="<%= url.actualurl %>"><%= url.actualurl %></td>
          <td class="td-short" title="http://localhost:8000/<%= url.shortid %>">http://localhost:8000/<%= url.shortid %></td>
          <td>
            <button class="row-copy"
              onclick="navigator.clipboard.writeText('http://localhost:8000/<%= url.shortid %>');this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)">
              Copy
            </button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <div class="about">
    <h3>How it works</h3>
    <p>Upins tracks your generated URLs using your IP address — no account needed.</p>
  </div>

  <footer>
    <p>All rights reserved &copy; — Built by <a href="https://www.linkedin.com/in/a-kashif-ahmed/" target="_blank">@a-kashif-ahmed</a></p>
  </footer>

</body>
</html>
